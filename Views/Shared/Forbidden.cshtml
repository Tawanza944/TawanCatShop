@using WebApplication1.ViewModels.Shared
@{
    ViewData["Title"] ??= "ไม่มีสิทธิ์เข้าถึง";
}

<section class="lc-status-page lc-container">
    <div class="lc-status-page__art">
        <partial name="_CatIllustration" model="new CatIllustration(CatPose.Peeking)" />
    </div>
    <span class="lc-status-page__code">403</span>
    <h1>หน้านี้ไม่ได้เปิดให้บัญชีของคุณนะ</h1>
    <p>บัญชีที่ใช้อยู่ไม่มีสิทธิ์ดูหน้านี้ ถ้าคิดว่าควรเข้าได้ ลองออกจากระบบแล้วเข้าด้วยบัญชีที่ถูกต้อง</p>
    <div class="lc-status-page__actions">
        <a class="lc-btn lc-btn--primary" asp-controller="Account" asp-action="Index">ไปหน้าของฉัน</a>
        <a class="lc-btn lc-btn--outline" asp-controller="Home" asp-action="Index">กลับหน้าแรก</a>
    </div>
</section>
