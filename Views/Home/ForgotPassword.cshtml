@model WebApplication1.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "ตั้งรหัสผ่านใหม่";
    Layout = "_BlankLayout";
}

<div class="lc-container">
    <div class="lc-auth">
        <div class="lc-auth__art">
            <div>
                <h2>ลืมรหัสผ่านใช่ไหม</h2>
                <p>กรอกอีเมลหรือชื่อผู้ใช้ แล้วตั้งรหัสผ่านใหม่ได้เลย</p>
            </div>
            <partial name="_CatIllustration" model="new CatIllustration(CatPose.Peeking)" />
        </div>

        <form class="lc-auth__form" asp-controller="Home" asp-action="ForgotPassword" method="post">
            <h1>ตั้งรหัสผ่านใหม่</h1>
            <div asp-validation-summary="ModelOnly"></div>

            <label class="lc-field">
                <span class="lc-label">อีเมล หรือ ชื่อผู้ใช้</span>
                <input class="lc-input" asp-for="EmailOrUser" autocomplete="username" autofocus />
                <span asp-validation-for="EmailOrUser"></span>
            </label>
            <label class="lc-field">
                <span class="lc-label">รหัสผ่านใหม่</span>
                <input class="lc-input" asp-for="NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </label>
            <label class="lc-field">
                <span class="lc-label">ยืนยันรหัสผ่านใหม่</span>
                <input class="lc-input" asp-for="ConfirmNewPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword"></span>
            </label>

            <button type="submit" class="lc-btn lc-btn--primary">บันทึกรหัสผ่านใหม่</button>
            <p class="lc-auth__switch"><a asp-controller="Home" asp-action="Login">กลับไปเข้าสู่ระบบ</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
