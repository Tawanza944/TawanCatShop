@model WebApplication1.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "สมัครสมาชิก";
    Layout = "_BlankLayout";
}

<div class="lc-container">
    <div class="lc-auth">
        <div class="lc-auth__art">
            <div>
                <h2>ยินดีต้อนรับสู่ LoveCat</h2>
                <p>สมัครแล้วเก็บโค้ดส่วนลด บันทึกที่อยู่ และรีวิวของที่ซื้อได้</p>
            </div>
            <partial name="_CatIllustration" model="new CatIllustration(CatPose.Stretching)" />
        </div>

        <form class="lc-auth__form" asp-controller="Home" asp-action="Register" method="post">
            <h1>สมัครสมาชิก</h1>
            <div asp-validation-summary="ModelOnly"></div>

            <div class="lc-auth__row">
                <label class="lc-field">
                    <span class="lc-label">ชื่อผู้ใช้</span>
                    <input class="lc-input" asp-for="Username" autocomplete="username" />
                    <span asp-validation-for="Username"></span>
                </label>
                <label class="lc-field">
                    <span class="lc-label">ชื่อ-นามสกุล</span>
                    <input class="lc-input" asp-for="Name" autocomplete="name" />
                    <span asp-validation-for="Name"></span>
                </label>
            </div>
            <div class="lc-auth__row">
                <label class="lc-field">
                    <span class="lc-label">อีเมล</span>
                    <input class="lc-input" asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </label>
                <label class="lc-field">
                    <span class="lc-label">เบอร์มือถือ</span>
                    <input class="lc-input" asp-for="PhoneNumber" autocomplete="tel" inputmode="numeric" />
                    <span asp-validation-for="PhoneNumber"></span>
                </label>
            </div>
            <div class="lc-auth__row">
                <label class="lc-field">
                    <span class="lc-label">รหัสผ่าน</span>
                    <input class="lc-input" asp-for="Password" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </label>
                <label class="lc-field">
                    <span class="lc-label">ยืนยันรหัสผ่าน</span>
                    <input class="lc-input" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </label>
            </div>

            <button type="submit" class="lc-btn lc-btn--primary">สมัครสมาชิก</button>
            <p class="lc-auth__switch">มีบัญชีแล้ว? <a asp-controller="Home" asp-action="Login">เข้าสู่ระบบ</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
