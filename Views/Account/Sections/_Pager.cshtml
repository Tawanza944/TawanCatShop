@model PagerModel
@if (Model.PageCount > 1)
{
    <nav class="lc-pager" aria-label="เปลี่ยนหน้า">
        <span>ทั้งหมด @Model.Total.ToString("N0") รายการ · หน้า @Model.Page / @Model.PageCount</span>
        <div>
            @if (Model.Page > 1)
            {
                <a class="lc-btn lc-btn--outline lc-btn--sm" asp-controller="Account" asp-action="@WebApplication1.ViewModels.Dashboard.DashboardRoutes.ActionFor(Model.Section)"
                   asp-route-pageNumber="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-filter="@Model.Filter"
                   asp-route-from="@PagerModel.Iso(Model.FromDate)" asp-route-to="@PagerModel.Iso(Model.ToDate)" asp-route-payout="@Model.Payout"><i class="bi bi-chevron-left" aria-hidden="true"></i> ก่อนหน้า</a>
            }
            @if (Model.Page < Model.PageCount)
            {
                <a class="lc-btn lc-btn--outline lc-btn--sm" asp-controller="Account" asp-action="@WebApplication1.ViewModels.Dashboard.DashboardRoutes.ActionFor(Model.Section)"
                   asp-route-pageNumber="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-filter="@Model.Filter"
                   asp-route-from="@PagerModel.Iso(Model.FromDate)" asp-route-to="@PagerModel.Iso(Model.ToDate)" asp-route-payout="@Model.Payout">ถัดไป <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            }
        </div>
    </nav>
}
