@* Totals block filled by the server quote (wwwroot/js/app/receipt.js). Used in the cart drawer and the checkout dialog. *@
<div class="lc-receipt" data-receipt>
    <div class="lc-receipt__row"><span>ราคาสินค้า</span><span data-receipt-subtotal>฿0</span></div>
    <div class="lc-receipt__row lc-receipt__row--discount" data-receipt-discount-row hidden><span data-receipt-discount-label>ส่วนลด</span><span data-receipt-discount>−฿0</span></div>
    <div class="lc-receipt__row lc-receipt__row--discount" data-receipt-reward-row hidden><span>เงินสะสม</span><span data-receipt-reward>−฿0</span></div>
    <div class="lc-receipt__row"><span>ค่าส่ง</span><span data-receipt-shipping>฿0</span></div>
    <div class="lc-receipt__total"><span>รวม</span><span data-receipt-total>฿0</span></div>
</div>
